		local killer = getFirstValidKillerModel()
		if not killer then return end

		if (id == TARGET_ANIMATION_ID or id == "106086955212611") and isEnabled then
			if distcheck then
				if not check(character.HumanoidRootPart, killer.HumanoidRootPart, distcheckstud) then return end
			end
