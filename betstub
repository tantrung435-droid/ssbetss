local function runPlaceSequence()
	if not isEnabled or running then return end
	running = true

	local tClaims = claimCount
	local tLed = predLed
	local tKm = getFirstValidKillerModel()
	local tHum = tKm and tKm:FindFirstChildOfClass("Humanoid")
	local tH0 = tHum and tHum.Health or -1

	local character = lp.Character
	if not character or not character.Parent then running = false; return; end
	local hrp = character:WaitForChild("HumanoidRootPart", 5)
	if not hrp then running = false; return; end

	task.wait(startdelay)

	if not character.Parent or not isEnabled then running = false; return; end

	local hum = character:FindFirstChildOfClass("Humanoid")
	local oldAutoRotate = hum and hum.AutoRotate or nil
	if autoAimEnabled and hum then
		pcall(function() hum.AutoRotate = false end)
	end
	resetYawPredictor()

	local ok, err = pcall(function()
		choreo = nil
		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not character.Parent or not hrp.Parent or not isEnabled then break end
			if autoAimEnabled then
				local km = abttSeqKiller()
				local khrp = km and km:FindFirstChild("HumanoidRootPart")
				if khrp then
					pcall(function()
						local pos = hrp.Position
						local flatDir = Vector3.new(khrp.Position.X - pos.X, 0, khrp.Position.Z - pos.Z)
						if flatDir.Magnitude > 0.05 and hrp.CFrame.LookVector:Dot(flatDir.Unit) < 0.99939 then
							hrp.CFrame = CFrame.lookAt(pos, pos + flatDir.Unit)
						end
					end)
				end
			end
			doitmate = true
			RunService.PreRender:Wait()
		end
	end)
	doitmate = false
	finishSequence(hum, oldAutoRotate)
	if not ok then warn("[ABM] Dagger sequence error: " .. tostring(err)) end
	task.delay(1.2, function()
		local hum2 = tKm and tKm.Parent and tKm:FindFirstChildOfClass("Humanoid")
		local dh = (hum2 and tH0 >= 0) and math.floor(tH0 - hum2.Health + 0.5) or -1
		if #ABTT_TEL.seqs > 499 then table.remove(ABTT_TEL.seqs, 1) end
		ABTT_TEL.seqs[#ABTT_TEL.seqs + 1] = { br = "M1", ts = os.time() - ABTT_TEL.t0, engage = -1, angle = -1, claims = claimCount - tClaims, led = predLed - tLed, dmg = dh, tier = abttTier(dh) }
	end)
	running = false
end

local function runDashstabSequence()
	if not isDashstabEnabled or running then return end
	running = true
	lungeEndedFlag = false

	local character = lp.Character
	if not character or not character.Parent then running = false; return; end

	local crouchElapsed = crouchStartAt and math.clamp(os.clock() - crouchStartAt, 0, 3.0) or 0
	local estStun = 2.0 + 1.5 * (crouchElapsed / 3.0)

	task.wait(dsStartDelay)

	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not character.Parent or not hrp then running = false; return; end

	local tClaims = claimCount
	local tLed = predLed
	local tKm = getFirstValidKillerModel()
	local tHum = tKm and tKm:FindFirstChildOfClass("Humanoid")
	local tH0 = tHum and tHum.Health or -1
	local tEngage = -1
	local seqDuration = duration
	local tAngle = -1
	local tWall = false
	local dsRayParams = RaycastParams.new()
	dsRayParams.FilterType = Enum.RaycastFilterType.Exclude
	dsRayParams.FilterDescendantsInstances = tKm and { character, tKm } or { character }
	do
		local km0 = tKm and tKm:FindFirstChild("HumanoidRootPart")
		if km0 and hrp then
			local hit = workspace:Raycast(hrp.Position, km0.Position - hrp.Position, dsRayParams)
			tWall = hit ~= nil
		end
	end
	do
		local khrp0 = tKm and tKm:FindFirstChild("HumanoidRootPart")
		if khrp0 and hrp then
			local dir = (khrp0.Position - hrp.Position) * Vector3.new(1, 0, 1)
			local kl = khrp0.CFrame.LookVector * Vector3.new(1, 0, 1)
			if dir.Magnitude > 0.05 and kl.Magnitude > 0.05 then
				tAngle = math.deg(math.acos(math.clamp(dir.Unit:Dot(kl.Unit), -1, 1)))
			end
		end
	end

	local hum = character:FindFirstChildOfClass("Humanoid")
	local oldAutoRotate = hum and hum.AutoRotate or nil
	if dsAimEnabled and hum then
		pcall(function() hum.AutoRotate = false end)
	end
	resetYawPredictor()
	local ok, err = pcall(function()
		choreo = nil
		seqDuration = duration
		do
			local km = abttSeqKiller()
			local khrp = km and km:FindFirstChild("HumanoidRootPart")
			if khrp and hrp then
				local rel = khrp.CFrame:PointToObjectSpace(hrp.Position)
				local side = rel.X >= 0 and 1 or -1
				local engage = (khrp.Position - hrp.Position).Magnitude
				local eta = math.max(0.10, engage / 30)
				choreo = { t0 = os.clock(), p0 = hrp.Position, side = side, eta = eta }
				seqDuration = math.max(eta + 0.15, 0.55)
				tEngage = engage
			end
		end

		local startTime = os.clock()
		while os.clock() - startTime < seqDuration do
			if not character.Parent or not hrp.Parent or not isDashstabEnabled or lungeEndedFlag then break end
			local canClaim = true
			local km = abttSeqKiller()
			local khrp = km and km:FindFirstChild("HumanoidRootPart")
			if khrp then
				if dsAimEnabled then
					pcall(function()
						local pos = hrp.Position
						local flatDir = Vector3.new(khrp.Position.X - pos.X, 0, khrp.Position.Z - pos.Z)
						if flatDir.Magnitude > 0.05 and hrp.CFrame.LookVector:Dot(flatDir.Unit) < 0.99939 then
							hrp.CFrame = CFrame.lookAt(pos, pos + flatDir.Unit)
						end
					end)
				end
				local delta = khrp.Position - hrp.Position
				if dsProxGate and delta.Magnitude > dsProxStuds then
					canClaim = false
				end
				if canClaim and dsWallCheck then
					local hit = workspace:Raycast(hrp.Position, delta, dsRayParams)
					if hit then
						canClaim = false
						tWall = true
					end
				end
			else
				canClaim = false
			end
			doitmate = canClaim
			RunService.PreRender:Wait()
		end
	end)
	choreo = nil
	doitmate = false
	finishSequence(hum, oldAutoRotate)
	if not ok then warn("[ABM] Lunge sequence error: " .. tostring(err)) end
	task.delay(1.2, function()
		local hum2 = tKm and tKm.Parent and tKm:FindFirstChildOfClass("Humanoid")
		local dh = (hum2 and tH0 >= 0) and math.floor(tH0 - hum2.Health + 0.5) or -1
		if #ABTT_TEL.seqs > 499 then table.remove(ABTT_TEL.seqs, 1) end
		ABTT_TEL.seqs[#ABTT_TEL.seqs + 1] = { br = "DS", ts = os.time() - ABTT_TEL.t0, engage = tEngage, angle = tAngle, wall = tWall and 1 or 0, window = seqDuration, stunEst = tonumber(string.format("%.2f", estStun)), claims = claimCount - tClaims, led = predLed - tLed, dmg = dh, tier = abttTier(dh) }
	end)
	running = false
end

