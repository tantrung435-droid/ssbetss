local function check(hrp1, hrp2, range)
	if not hrp1 or not hrp2 then
		return false
	end

	return (hrp1.Position - hrp2.Position).Magnitude <= range
end

local function bindNoSlowMultiplier(v)
	if not v or not v:IsA("NumberValue") then return end
	if v.Name == "TwoTimeCrouching" or v.Name == "TwoTimeStab" then
		if noCrouchSlow and v.Value < 1 then
			v.Value = 1
		end
		keep(v:GetPropertyChangedSignal("Value"):Connect(function()
			if noCrouchSlow and not abttDead and v.Value < 1 then
				v.Value = 1
			end
		end))
	end
end

local function hookCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end
	local animator = humanoid:FindFirstChild("Animator")
	if not animator then return end
	crouchStartAt = character:GetAttribute("Crouching") and os.clock() or nil
	keep(character:GetAttributeChangedSignal("Crouching"):Connect(function()
		if character:GetAttribute("Crouching") then
			crouchStartAt = os.clock()
		else
			crouchStartAt = nil
		end
	end))
	task.spawn(function()
		local multFolder = character:FindFirstChild("SpeedMultipliers") or character:WaitForChild("SpeedMultipliers", 3)
		if multFolder then
			for _, child in ipairs(multFolder:GetChildren()) do
				bindNoSlowMultiplier(child)
			end
			keep(multFolder.ChildAdded:Connect(bindNoSlowMultiplier))
		end
	end)
	keep(animator.AnimationPlayed:Connect(function(track)
		if not track or not track.Animation then return end
		local id = tostring(track.Animation.AnimationId or ""):gsub("%D", "")
		if id == LUNGE_END_ANIM_ID then
			lungeEndedFlag = true
