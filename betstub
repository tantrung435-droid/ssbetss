-- Variables for manual speed calculation
local lastKillerModel = nil
local lastKillerPos = nil
local smoothedSpeed = 0
local speedSampleDt = 0

-- Hook into physics steps to calculate Auto Studs & Crouch Stun HUD
keep(RunService.Heartbeat:Connect(function(dt)
	ABTT_fpsAcc = ABTT_fpsAcc + dt
	ABTT_fpsN = ABTT_fpsN + 1
	if os.clock() - ABTT_fpsAt >= 0.5 and ABTT_fpsAcc > 0 then
		ABTT_fps = math.floor(ABTT_fpsN / ABTT_fpsAcc + 0.5)
		ABTT_fpsAcc, ABTT_fpsN, ABTT_fpsAt = 0, 0, os.clock()
	end
	if crouchHudEnabled and crouchStartAt and stunHudLabel then
		local elapsed = math.clamp(os.clock() - crouchStartAt, 0, 3.0)
		local stunVal = 2.0 + 1.5 * (elapsed / 3.0)
		stunHudLabel.Visible = true
		if elapsed >= 3.0 then
			stunHudLabel.Text = "Stun: 3.5s [MAX]"
			stunHudLabel.TextColor3 = Color3.fromHex("#38bdf8")
		else
			stunHudLabel.Text = string.format("Stun: %.1fs (%.1fs)", stunVal, elapsed)
			stunHudLabel.TextColor3 = Color3.fromHex("#f0f9ff")
		end
	elseif stunHudLabel and stunHudLabel.Visible then
		stunHudLabel.Visible = false
	end
	if isAutoStudsEnabled then
		local killerModel = getFirstValidKillerModel()
		if killerModel then
			local killerHrp = killerModel:FindFirstChild("HumanoidRootPart")
			if killerHrp then
				local currentPos = killerHrp.Position
			speedSampleDt = speedSampleDt + dt
			if lastKillerModel ~= killerModel or not lastKillerPos then
				lastKillerModel = killerModel
				lastKillerPos = currentPos
				speedSampleDt = 0
			elseif speedSampleDt >= 0.015 then
				local horizontalDelta = Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(lastKillerPos.X, 0, lastKillerPos.Z)
				local deltaSpeed = horizontalDelta.Magnitude / speedSampleDt
				local kvel = killerHrp.AssemblyLinearVelocity
				local velSpeed = Vector3.new(kvel.X, 0, kvel.Z).Magnitude
				local rawSpeed = (velSpeed > 0.5) and (deltaSpeed * 0.5 + velSpeed * 0.5) or deltaSpeed
				smoothedSpeed = smoothedSpeed + (rawSpeed - smoothedSpeed) * math.min(speedSampleDt * 15, 1)
				lastKillerPos = currentPos
				speedSampleDt = 0
			end
			local finalSpeed = math.clamp(smoothedSpeed, 0, 30)
				
				-- Determine target studs at max run speed (26 velocity)
				local studsAtRun = autoRunStuds
				if isDetectPingEnabled then
					local ping = getPing()
					local clampedPing = math.max(ping, 20)
					-- Linear map between ping 20 (autoRunStuds) and ping 120 (autoRunStuds - 1.5)
					studsAtRun = autoRunStuds - ((clampedPing - 20) / 100) * 1.5
					studsAtRun = math.max(studsAtRun, 1.0) -- Safety cap
				end
				
				-- Calculate actual studs based on current speed
				local slope = (autoStandStuds - studsAtRun) / 26.0
				local calculatedStuds = autoStandStuds - (finalSpeed * slope)
				
				behindstuds = calculatedStuds
				
				-- v1.1-tt (A160): WindUI Input element không có IsFocused() — Set() throttle
				if behindStudsBox and os.clock() - lastBoxSync > 0.25 then
					lastBoxSync = os.clock()
					pcall(function() behindStudsBox:Set(string.format("%.1f", calculatedStuds)) end)
				end
			else
				lastKillerModel = nil
			end
		else
			lastKillerModel = nil
			smoothedSpeed = 0
		end
	else
		lastKillerModel = nil
		smoothedSpeed = 0
	end
end))

