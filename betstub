		elseif (id == DASHSTAB_ANIM_ID or id == "107640065977686") and isDashstabEnabled then
			if distcheck then
				if not check(character.HumanoidRootPart, killer.HumanoidRootPart, math.max(distcheckstud, 24)) then return end
			end
			task.spawn(runDashstabSequence)
		end
	end))
