-- v4.1 fix #8: cache killer model, refresh theo ChildAdded/ChildRemoved
-- A114: scan dùng GetDescendants (GIỮ NGUYÊN semantics v4 gốc — model killer lồng sâu,
-- GetChildren sẽ không thấy → regression autostuds chết + spoof chết, user bắt được)
local cachedKillerModel = nil
-- v4.4 (A150) FIX LAG-1: debounce 0.25s — bản cũ: cache rỗng (giữa round/killer chết) thì
-- Heartbeat gọi GetDescendants() FULL-SCAN MỖI FRAME (60-144Hz, mỗi lần 1 array mới cho GC)
-- + bão ChildAdded đầu round quét O(n²) → nguồn lag chính khi dùng dài. Giờ: tối đa 4 scan/s.
local lastScanAt = 0
local function refreshKillerCache(force)
	-- v4.5.1: bỏ debounce khi đang sequence (doitmate) — cache trễ ≤0.25s giữa dashstab làm
	-- hook passthrough packet THẬT đúng lúc cần claim sau lưng
	if not force and not doitmate and os.clock() - lastScanAt < 0.25 then return end
	lastScanAt = os.clock()
	cachedKillerModel = nil
	local killerFolder = getKillerFolder()
	if not killerFolder then return end
	for _, inst in ipairs(killerFolder:GetDescendants()) do
		if inst:IsA("Model") then
			local hum = inst:FindFirstChildOfClass("Humanoid")
			local hrp = inst:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				cachedKillerModel = inst
				return
			end
		end
	end
end

local function getFirstValidKillerModel()
	local m = cachedKillerModel
	-- A114: IsDescendantOf(workspace) thay m.Parent — bắt cả trường hợp ancestor bị remove
	-- (m.Parent vẫn non-nil trên object đã rời cây)
	if m and m:IsDescendantOf(workspace) then
		local hum = m:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and m:FindFirstChild("HumanoidRootPart") then return m end
	end
	refreshKillerCache()
	return cachedKillerModel
end

-- v1.4.2-tt (A540): trong-sequence dùng model-cache (vẫn-đọc VỊ-TRÍ live từ model —
-- homing không đổi); model chết/mất-cây mới cho refresh. GetDescendants full-scan
-- mỗi-frame/packet trong sequence là nguồn fps-dip 0.2-0.5s (v4.5.1 bỏ-debounce).
local function abttSeqKiller()
	if seqKillerRef and seqKillerRef:IsDescendantOf(workspace) then
		local h = seqKillerRef:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 and seqKillerRef:FindFirstChild("HumanoidRootPart") then
			return seqKillerRef
		end
	end
	seqKillerRef = getFirstValidKillerModel()
	return seqKillerRef
end

task.spawn(function()
	local folder = getKillerFolder()
	local tries = 0
	while not folder and tries < 60 do
		tries = tries + 1
		task.wait(1)
		folder = getKillerFolder()
	end
	if folder then
		keep(folder.ChildAdded:Connect(function() refreshKillerCache() end))
		keep(folder.ChildRemoved:Connect(function() cachedKillerModel = nil end))
		refreshKillerCache()
	end
end)

-- v4.4 (A150) FIX LAG-2: cache 0.5s — detect-ping bật thì getPing() chạy MỖI Heartbeat
-- (60-144Hz, mỗi lần 2 pcall + đọc Stats) → giờ tối đa 2 lần/s.
local pingCache, pingCacheAt = 0, 0
local function getPing()
	local now = os.clock()
	if now - pingCacheAt < 0.5 then return pingCache end
	local success, val = pcall(function()
		return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if success and val then pingCache, pingCacheAt = val, now; return val; end

	local success2, val2 = pcall(function()
		return lp:GetNetworkPing() * 1000
	end)
	if success2 and val2 then pingCache, pingCacheAt = val2, now; return val2; end

	pingCache, pingCacheAt = 20, now
	return 20 -- Default fallback ping
end

-- v1.4.1-tt (A539): DỰ-ĐOÁN-YAW-KILLER — killer xoay-nhanh làm điểm-sau-lưng-stale
-- ở server (trễ nửa-RTT + kiểm lúc đòn-rơi). Đo tốc-yaw giữa các packet → ngoại-suy
-- hướng sau hor = ping/2 + 0.10s (clamp 0.05–0.25) · clamp |rate|≤6 rad/s (fidget-spin)
-- · lead-vị-trí-ngang-nhẹ (<30 studs/s) · rate≈0 → GIỐNG-HỆT công-thức-cũ (A215).
local lastKYaw, lastKYawAt, kYawRate = nil, nil, 0
local predLed = 0 -- đếm-số-packet-có-dự-đoán (console-led falsifiable)
local function resetYawPredictor()
	lastKYaw, lastKYawAt, kYawRate = nil, nil, 0
end
local function predictedBehindTarget(killerHrp, behindstuds)
	local cf = killerHrp.CFrame
	local lv = cf.LookVector
	local yaw = math.atan2(-lv.X, -lv.Z)
	local now = os.clock()
	if not lastKYaw or not lastKYawAt then
		lastKYaw, lastKYawAt, kYawRate = yaw, now, 0
	else
		local dt = now - lastKYawAt
		if dt >= 0.5 then
			lastKYaw, lastKYawAt, kYawRate = yaw, now, 0
		elseif dt >= 0.015 then
			local d = yaw - lastKYaw
			if d > math.pi then d = d - 2 * math.pi elseif d < -math.pi then d = d + 2 * math.pi end
			local inst = math.clamp(d / dt, -6, 6)
			kYawRate = kYawRate * 0.5 + inst * 0.5
			lastKYaw, lastKYawAt = yaw, now
		end
	end
	local hor = math.clamp(getPing() * 0.0005 + 0.10, 0.05, 0.25)
	local yawP = yaw + kYawRate * hor
	local lvP = Vector3.new(-math.sin(yawP), 0, -math.cos(yawP))
	local kpos = cf.Position
	local kvel = killerHrp.AssemblyLinearVelocity
	if kvel.Magnitude < 30 then
		kpos = kpos + Vector3.new(kvel.X, 0, kvel.Z) * hor
	end
	if math.abs(kYawRate) > 0.5 then predLed = predLed + 1 end
	local c = kpos - lvP * behindstuds
	return CFrame.lookAt(c, kpos)
end
local function abttCtx()
	return string.format("v%s | %s | %dms | %dfps", version,
		identifyexecutor and identifyexecutor() or "executor",
		math.floor(getPing() + 0.5), ABTT_fps)
end
local function abttTier(dh)
	if dh >= 20 then return "backstab" end
	if dh >= 8 then return "front" end
	if dh == 0 then return "miss" end
	return "unknown"
end
abttExport = function()
	local n = { ds = 0, m1 = 0, dsReg = 0, dsFront = 0, dsMiss = 0 }
	for _, s2 in ipairs(ABTT_TEL.seqs) do
